{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "small",
        "source": "arch",
        "padding": {
            "right": 3
        },
        "color": {
            "1": "green",
            "2": "blue"
        }
    },

    "display": {
        "separator": "    ",
        "color": {
            "keys": "green",
            "title": "magenta",
            "output": "default",
            "separator": "blue"
        },
        "key": {
            "width": 14
        }
    },

    "modules": [
        "title",
        "separator",

        {
            "type": "os",
            "key": "󰣇 OS"
        },
        {
            "type": "host",
            "key": "󰌢 Machine"
        },
        {
            "type": "kernel",
            "key": "󰒋 Kernel"
        },
        {
            "type": "uptime",
            "key": "󰅐 Uptime"
        },
        {
            "type": "packages",
            "key": "󰏖 Packages"
        },

        "break",

        {
            "type": "wm",
            "key": " WM",
            "keyColor": "blue"
        },
        {
            "type": "shell",
            "key": " Shell",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": " Terminal",
            "keyColor": "blue"
        },
        {
            "type": "display",
            "key": "󰍹 Display",
            "keyColor": "blue"
        },

        "break",

        {
            "type": "cpu",
            "key": "󰻠 CPU",
            "keyColor": "magenta"
        },
        {
            "type": "gpu",
            "key": "󰍛 GPU",
            "keyColor": "magenta"
        },
        {
            "type": "memory",
            "key": "󰑭 Memory",
            "keyColor": "magenta"
        },
        {
            "type": "disk",
            "key": " Disk",
            "keyColor": "magenta"
        },

        "break",
        "colors"
    ]
}
