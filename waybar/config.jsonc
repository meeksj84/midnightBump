{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 6,
  "margin-top": 4,
  "margin-left": 6,
  "margin-right": 6,
  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "group/music"
  ],
  "modules-right": [
    "network",
    "pulseaudio",
    "temperature",
    "memory",
    "battery",
    "tray",
    "clock",
    "custom/power"
  ],
  "custom/launcher": {
    "format": "󰣇",
    "tooltip": false,
    "on-click": "rofi -show drun"
  },
  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{icon}",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "format-icons": {
      "1": "",
      "2": "󰈹",
      "3": "",
      "4": "󰎆",
      "5": "󰍹",
      "active": "",
      "default": ""
    },
    "persistent-workspaces": {
      "*": 5
    }
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 18,
    "separate-outputs": true,
    "rewrite": {
      "^(.*) — Mozilla Firefox$": "$1",
      "^(.*) - Visual Studio Code$": "$1",
      "^(.*) - kitty$": "$1"
    }
  },
  "mpris": {
    "format": "{artist} — {title}",
    "format-paused": "󰏤  {artist} — {title}",
    "format-stopped": "󰝚  Not Playing",
    "max-length": 36,
    "tooltip-format": "{artist} — {title}\\n{album}",
    "player-icons": {
      "default": "󰎆",
      "spotify": "",
      "firefox": "󰈹"
    },
    "status-icons": {
      "paused": "󰏤"
    },
    "player": "spotify",
    "on-click": "playerctl --player=spotify play-pause",
    "on-click-middle": "playerctl --player=spotify play-pause",
    "on-click-right": "setsid -f flatpak run com.spotify.Client >/dev/null 2>&1",
    "on-scroll-up": "playerctl --player=spotify next",
    "on-scroll-down": "playerctl --player=spotify previous"
  },
  "clock": {
    "format": "󰃭  {:%a %d %b  %I:%M %p}",
    "format-alt": "{:%A, %B %d, %Y}",
    "tooltip": false
  },
  "network": {
    "format-wifi": "󰖩  {signalStrength}%",
    "format-ethernet": "󰈀 ",
    "format-disconnected": "󰖪 ",
    "tooltip-format-wifi": "{essid}\n{ipaddr}\n{signalStrength}%",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 18
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰖁  muted",
    "format-icons": {
      "headphone": "",
      "headset": "󰋎",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "tooltip-format": "Volume: {volume}%"
  },
  "temperature": {
    "critical-threshold": 80,
    "format": "  {temperatureC}°",
    "format-critical": "  {temperatureC}°",
    "tooltip": true
  },
  "memory": {
    "interval": 5,
    "format": "  {percentage}%",
    "tooltip-format": "Memory: {used:0.1f} GiB / {total:0.1f} GiB"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-plugged": "  {capacity}%",
    "format-full": "󰁹  {capacity}%",
    "format-alt": "{time}  {icon}",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "tooltip-format": "{timeTo}\n{capacity}%"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 4
  },
  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "wlogout",
    "on-click-right": "systemctl poweroff"
  },
  "group/music": {
    "orientation": "horizontal",
    "modules": [
      "custom/cava",
      "mpris"
    ]
  },
  "custom/cava": {
    "exec": "$HOME/.config/waybar/scripts/cava-waybar.sh",
    "format": "{}",
    "tooltip": false,
    "exec-on-event": false,
    "on-click": "$HOME/.config/waybar/scripts/music-menu.sh",
    "on-click-middle": "playerctl --player=spotify play-pause",
    "on-click-right": "setsid -f flatpak run com.spotify.Client >/dev/null 2>&1",
    "on-scroll-up": "playerctl --player=spotify next",
    "on-scroll-down": "playerctl --player=spotify previous"
  }
}
