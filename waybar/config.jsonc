{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 6,
  "margin-top": 4,
  "margin-left": 6,
  "margin-right": 6,

  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "hyprland/window",
    "mpris"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "network",
    "pulseaudio",
    "temperature",
    "memory",
    "battery",
    "tray",
    "custom/power"
  ],

  "custom/launcher": {
    "format": "󰣇",
    "tooltip": false,
    "on-click": "rofi -show drun"
  },

  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{icon}",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "format-icons": {
      "1": "",
      "2": "󰈹",
      "3": "",
      "4": "󰎆",
      "5": "󰍹",
      "active": "",
      "default": ""
    },
    "persistent-workspaces": {
      "*": 5
    }
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 18,
    "separate-outputs": true,
    "rewrite": {
      "^(.*) — Mozilla Firefox$": "$1",
      "^(.*) - Visual Studio Code$": "$1",
      "^(.*) - kitty$": "$1"
    }
  },

  "mpris": {
    "format": "󰎆  {artist} — {title}",
    "format-paused": "󰏤  {artist} — {title}",
    "format-stopped": "󰝚  Not Playing",
    "max-length": 18,
    "tooltip-format": "{player}: {artist} — {title}",
    "player-icons": {
      "default": "󰎆",
      "spotify": "",
      "firefox": "󰈹"
    },
    "status-icons": {
      "paused": "󰏤"
    }
  },

  "clock": {
    "format": "󰃭  {:%a %d %b  %I:%M %p}",
    "format-alt": "{:%A, %B %d, %Y}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#dee3e5'><b>{}</b></span>",
        "days": "<span color='#bfc8cb'><b>{}</b></span>",
        "weeks": "<span color='#83d2e5'><b>W{}</b></span>",
        "weekdays": "<span color='#83d2e5'><b>{}</b></span>",
        "today": "<span color='#ffb4ab'><b><u>{}</u></b></span>"
      }
    }
  },

  "network": {
    "format-wifi": "󰖩  {signalStrength}%",
    "format-ethernet": "󰈀 ",
    "format-disconnected": "󰖪 ",
    "tooltip-format-wifi": "{essid}\n{ipaddr}\n{signalStrength}%",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 18
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰖁  muted",
    "format-icons": {
      "headphone": "",
      "headset": "󰋎",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "tooltip-format": "Volume: {volume}%"
  },

  "temperature": {
    "critical-threshold": 80,
    "format": "  {temperatureC}°",
    "format-critical": "  {temperatureC}°",
    "tooltip": true
  },

  "memory": {
    "interval": 5,
    "format": "  {percentage}%",
    "tooltip-format": "Memory: {used:0.1f} GiB / {total:0.1f} GiB"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-plugged": "  {capacity}%",
    "format-full": "󰁹  {capacity}%",
    "format-alt": "{time}  {icon}",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "tooltip-format": "{timeTo}\n{capacity}%"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 4
  },

  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "wlogout",
    "on-click-right": "systemctl poweroff"
  }
}

